# Copia este archivo como .env solo para valores no sensibles. En produccion,
# inyecta secretos desde Docker/Swarm, el panel de despliegue o un secret manager.

# Secretos obligatorios de Docker Compose. No existen valores predeterminados.
DOCENTOS_POSTGRES_PASSWORD=""
DOCENTOS_BACKUP_PASSPHRASE=""

# Clave maestra del cifrado en reposo: protege el secreto TOTP de cada cuenta y
# la configuracion de los plugins (URL de webhook, claves de API). 32 bytes en
# base64. Obligatoria en staging y produccion: sin ella la aplicacion no arranca.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, lo ya cifrado no se recupera. Guardala como guardas la de la base.
DOCENTOS_ENCRYPTION_KEY=""

# Para ejecutar Node/Prisma directamente fuera de Compose. Codifica los
# caracteres especiales de la contraseña como URL antes de completar la cadena.
DATABASE_URL="postgresql://docentos:<URL_ENCODED_PASSWORD>@localhost:5432/docentos_db?schema=public"
DATABASE_USER="docentos"
DATABASE_NAME="docentos_db"

# URL y origen exactos; ALLOWED_ORIGIN acepta una lista separada por comas.
APP_URL="http://localhost:3000"
ALLOWED_ORIGIN="http://localhost:3000"
APP_PORT="3000"
DOCENTOS_ENV="production"
# report registra infracciones; enforce las bloquea. Por defecto: report en
# development, enforce en staging y production.
CSP_MODE="enforce"

# Confianza en X-Forwarded-For. Dejalo en "false" cuando DocentOS recibe el
# trafico directamente: confiar en la cabecera sin un proxy delante permite a
# cualquier cliente falsear su IP y esquivar los limites de intentos de login.
# Detras de un reverse proxy indica el numero de saltos ("1") o la lista de IPs.
TRUST_PROXY="false"

# Una sola instancia puede usar memoria. Para varias instancias, configura el
# mismo Redis privado, namespace y clave de cifrado; exige Redis con true.
# No publiques su puerto en Internet; usa autenticacion y rediss:// fuera de
# una red privada. Un reinicio sin Redis restablece los contadores locales.
REDIS_URL=""
RATE_LIMIT_REQUIRE_REDIS="false"
RATE_LIMIT_NAMESPACE="docentos"
# API por cuenta verificada: reserva para rafagas y reposicion por minuto.
RATE_LIMIT_API_BURST="120"
RATE_LIMIT_API_PER_MINUTE="120"
RATE_LIMIT_ANON_PER_MINUTE="300"
# Techo de trafico por IP, separado del uso normal por cuenta.
RATE_LIMIT_IP_PER_MINUTE="12000"
# Escrituras y operaciones costosas tienen presupuestos independientes.
RATE_LIMIT_WRITE_PER_MINUTE="30"
RATE_LIMIT_WRITE_BURST="30"
RATE_LIMIT_EXPENSIVE_PER_15_MINUTES="20"
LOGIN_FREE_ATTEMPTS="5"
LOGIN_FAILURE_WINDOW_MINUTES="15"
LOGIN_BACKOFF_INITIAL_SECONDS="30"
LOGIN_BACKOFF_MAX_SECONDS="300"
# Tras 5 fallos: 30 s, 60 s, 120 s y hasta 300 s; se conserva la recuperación.
# Redis caido: las lecturas conservan limites locales; las escrituras sensibles
# responden 503 con Retry-After. No se repiten automaticamente pagos ni examenes.
# Cloudflare requiere proteger el origen y confiar solo en el proxy real.
# No confies en CF-Connecting-IP recibido directamente desde Internet.

# Release y sesiones.
DOCENTOS_EDITION="community"
GIT_COMMIT_SHA=""
SESSION_COOKIE_NAME="docentos_session"
SESSION_TTL_DAYS="7"
# Vacio activa Secure automaticamente cuando APP_URL usa HTTPS.
SESSION_COOKIE_SECURE=""

# Recuperacion de contraseña.
PASSWORD_RESET_TTL_MINUTES="30"
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_TOKEN=""
PASSWORD_RESET_EXPOSE_TOKEN="false"

# Alta de alumnos desde la API de pagos de la landing (POST /api/integrations/enrollments).
# Vacio = la ruta no existe. Minimo 32 caracteres; el mismo valor va en
# DOCENTOS_TOKEN_INTEGRACION de la API de pagos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_API_TOKEN=""
# Mentor (ADMIN o MENTOR) de quien llega pagando; vacio = el primero activo.
INTEGRATION_MENTOR_EMAIL=""

# Libro de Reclamaciones virtual (obligatorio en Peru para vender en linea).
# Vacio = no se muestra el enlace en la portada, el pie ni el muro de pago.
COMPLAINTS_BOOK_URL=""
# Horas que dura el enlace para crear la contraseña que recibe un alumno nuevo.
ACTIVATION_TTL_HOURS="72"

# Datos demo: solo se permiten con DOCENTOS_ENV=development.
SEED_DEMO_DATA="false"

# Configuracion publica inyectada en tiempo de ejecucion, sin reconstruir Vite.
APP_NAME="DocentOS"
APP_TAGLINE="Plataforma e-Learning Open Source"
APP_LOGO_INITIAL="D"
APP_LOGO_URL=""
POWERED_BY_TEXT="Powered by DocentOS LMS Engine"
POWERED_BY_LINK="https://github.com/giantucchi-org/docentos"
AUTHOR_CREDIT="DocentOS Community Edition"
DEFAULT_LANG="es"
AI_ASSISTANT_NAME="Ian"

# Backups locales cifrados y retencion por cantidad de copias.
BACKUP_INTERVAL_SECONDS="86400"
BACKUP_RETRY_SECONDS="300"
BACKUP_DATABASE_WAIT_SECONDS="60"
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="5"
BACKUP_RETENTION_MONTHLY="12"
BACKUP_ALERT_WEBHOOK_URL=""

# S3 es opcional. Se recomienda un rol IAM; si no existe, inyecta las
# credenciales desde el panel y nunca las confirmes en Git.
S3_BUCKET=""
S3_PREFIX="docentos"
S3_STORAGE_CLASS="STANDARD_IA"
AWS_DEFAULT_REGION="us-east-1"
AWS_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Integraciones opcionales.
GIANTUCCHI_TELEMETRY_WEBHOOK=""
GEMINI_API_KEY=""

# Organizacion con IA de los cursos importados desde Google Drive.
# AI_PROVIDER=auto prefiere OpenAI y usa DeepSeek cuando solo hay clave de DeepSeek.
# Sin ninguna clave la importacion sigue funcionando: solo se pierde el pulido de titulos.
AI_PROVIDER="auto"
AI_REQUEST_TIMEOUT_MS="60000"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Topes del recorrido de carpetas de Drive al importar un curso.
DRIVE_IMPORT_ENABLED="true"
DRIVE_IMPORT_MAX_DEPTH="4"
DRIVE_IMPORT_MAX_NODES="3000"
# Disco (MB) para guardar los videos de Drive: cada video se baja de Google una
# vez y se reproduce desde aquí, sin las esperas de 1,5-7 s de Drive por tramo.
# Videos de más de la mitad de este tamaño no se guardan. 0 la desactiva.
DRIVE_STREAM_CACHE_MB="2048"
# Carpeta de la caché (por defecto, la temporal del sistema).
# DRIVE_VIDEO_CACHE_DIR=""
DRIVE_IMPORT_CONCURRENCY="4"
DRIVE_IMPORT_TIMEOUT_MS="120000"
GOOGLE_DRIVE_API_KEY=""
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI YouTube Course Builder
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"
YOUTUBE_API_KEY=""
AI_API_KEY=""
