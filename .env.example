# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Release metadata exposed by GET /api/version.
DOCENTOS_EDITION="community"
GIT_COMMIT_SHA=""

# Database Configuration
DATABASE_URL="postgresql://docentos:docentos_secret_pass@localhost:5432/docentos_db?schema=public"

# Google Drive API Integration
GOOGLE_DRIVE_API_KEY=""
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Stripe Payment Gateway
STRIPE_SECRET_KEY=""

# Telemetry & Call Home Configuration
GIANTUCCHI_TELEMETRY_WEBHOOK="https://telemetry.giantucchi.com/api/v1/installations"

# White-Label & Identity Configuration
VITE_APP_NAME="DocentOS"
VITE_APP_TAGLINE="The AI-Native, Open-Source Learning Engine"
VITE_APP_LOGO_INITIAL="D"
VITE_APP_LOGO_URL=""
VITE_POWERED_BY_TEXT="Powered by DocentOS • Built by Giantucchi"
VITE_POWERED_BY_LINK="https://github.com/giantucchi/docentos"
VITE_DEFAULT_LANG="es"
VITE_AI_ASSISTANT_NAME="Ian"
