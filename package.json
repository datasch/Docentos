{
  "name": "docentos-lms",
  "description": "DocentOS - The AI-Native, Open-Source Learning Engine. Created and maintained by Giantucchi (Jose Luis Hernandez Hernandez).",
  "private": true,
  "version": "0.5.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && esbuild prisma/seed.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/seed.js",
    "start": "NODE_ENV=production node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:adopt": "node scripts/prepare-migration-history.mjs",
    "prisma:migrate": "npm run prisma:adopt && prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "node dist/seed.js",
    "prisma:seed:dev": "tsx prisma/seed.ts",
    "secrets:init": "node scripts/init-local-secrets.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "version:check": "node scripts/check-version.mjs",
    "verify": "npm run version:check && npm run lint && npm run build",
    "lint": "tsc --noEmit",
    "test:business": "tsx --test tests/business-flows.test.ts",
    "test:auth": "tsx --test tests/auth-lifecycle.test.ts",
    "test": "tsx --test tests/business-flows.test.ts tests/auth-lifecycle.test.ts tests/security-regressions.test.ts tests/course-import.test.ts tests/course-import-ui.test.tsx tests/module-quiz.test.tsx tests/course-navigation.test.tsx",
    "test:security": "tsx --test tests/security-regressions.test.ts",
    "test:import": "tsx --test tests/course-import.test.ts tests/course-import-ui.test.tsx tests/module-quiz.test.tsx tests/course-navigation.test.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^174.0.0",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "stripe": "^22.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
