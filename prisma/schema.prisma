// Prisma Schema for Academia Giantucchi
// Supports RBAC roles (ADMIN, VIP, EXTERNAL), Paywall & VIP Bypass, Google Drive Videos, Mentorship Q&A, and Payments

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MENTOR
  MENTEE
  PUBLIC_USER
  VIP
  EXTERNAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REVOKED
  EXPIRED
}

enum EnrollmentSource {
  PAYMENT
  ADMIN
  MENTORSHIP
  IMPORT
}

enum ContentSource {
  GOOGLE_DRIVE
  EXTERNAL_URL
  DEMO
}

enum ResourceKind {
  FILE
  LINK
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String?
  name                String
  role                Role                 @default(PUBLIC_USER)
  avatarUrl           String?
  strikes             Int                  @default(0)
  isActive            Boolean              @default(true)
  payments            Payment[]
  comments            MentorshipComment[]
  progress            UserProgress[]
  videoNotes          VideoNote[]
  feedback            Feedback[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  mentorAssignments   MenteeAssignment[]   @relation("MentorAssignments")
  menteeAssignments   MenteeAssignment[]   @relation("MenteeAssignments")
  enrollments         CourseEnrollment[]
  certificates        Certificate[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  targetType   String
  targetId     String?
  metadataJson String   @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model InstanceConfig {
  id               String    @id @default("singleton")
  institutionName  String    @default("DocentOS")
  appTagline       String    @default("Plataforma e-Learning Open Source")
  logoInitial      String    @default("D")
  logoUrl          String    @default("")
  poweredByText    String    @default("Powered by DocentOS LMS Engine")
  poweredByLink    String    @default("https://github.com/giantucchi-org/docentos")
  authorCredit     String    @default("DocentOS Community Edition")
  defaultLanguage  String    @default("es")
  assistantName    String    @default("Ian")
  telemetryConsent Boolean   @default(false)
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Plugin {
  id          String   @id
  name        String
  description String
  version     String
  enabled     Boolean  @default(true)
  category    String
  icon        String   @default("Puzzle")
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenteeAssignment {
  id                   String   @id @default(uuid())
  mentorId             String
  menteeId             String
  courseId             String
  mentor               User     @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee               User     @relation("MenteeAssignments", fields: [menteeId], references: [id], onDelete: Cascade)
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseProgress       Int      @default(0)
  completedVideosCount Int      @default(0)
  totalVideosCount     Int      @default(0)
  lastActiveDate       String   @default("Reciente")
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([menteeId, courseId])
  @@index([mentorId])
  @@index([mentorId, courseId, status])
}

model Course {
  id                String             @id @default(uuid())
  title             String
  description       String
  price             Float
  currency          String             @default("USD")
  published         Boolean            @default(true)
  publishedAt       DateTime?
  isDemo            Boolean            @default(false)
  coverImage        String
  category          String             @default("Mentoría Elite")
  /// Carpeta de Google Drive de la que se importo, cuando vino de ahi.
  driveFolderId     String?
  modules           Module[]
  payments          Payment[]
  enrollments       CourseEnrollment[]
  certificates      Certificate[]
  resources         CourseResource[]
  menteeAssignments MenteeAssignment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([driveFolderId])
}

model Module {
  id          String           @id @default(uuid())
  title       String
  description String?
  order       Int
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos      VideoDriveLink[]
  resources   CourseResource[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([courseId, order])
}

model VideoDriveLink {
  id          String              @id @default(uuid())
  driveFileId String
  title       String
  description String?
  duration    String?
  mimeType    String              @default("video/mp4")
  embedUrl    String
  previewUrl  String?
  source      ContentSource       @default(EXTERNAL_URL)
  order       Int
  moduleId    String
  module      Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  comments    MentorshipComment[]
  progress    UserProgress[]
  videoNotes  VideoNote[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([moduleId, order])
  @@index([driveFileId])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount                Float
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  provider              String        @default("stripe")
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  idempotencyKey        String?       @unique
  checkoutUrl           String?
  failureCode           String?
  failureMessage        String?
  refundedAmount        Float         @default(0)
  completedAt           DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId, courseId, status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  eventType       String
  payloadHash     String
  processedAt     DateTime @default(now())

  @@index([eventType])
  @@index([processedAt])
}

model CourseEnrollment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource
  accessExpiresAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([accessExpiresAt])
}

model CourseResource {
  id             String        @id @default(uuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  kind           ResourceKind  @default(FILE)
  source         ContentSource @default(EXTERNAL_URL)
  externalFileId String?
  privateUrl     String
  mimeType       String?
  sizeBytes      BigInt?
  order          Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([courseId, order])
  @@index([moduleId, order])
  @@index([externalFileId])
}

model Certificate {
  id                  String   @id @default(uuid())
  verificationCode    String   @unique
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipientName       String
  courseTitle         String
  completionPercent   Int      @default(100)
  issuedAt            DateTime @default(now())
  revokedAt           DateTime?
  revocationReason    String?
  metadataJson        String   @default("{}")

  @@unique([userId, courseId])
  @@index([issuedAt])
}

model MentorshipComment {
  id               String              @id @default(uuid())
  content          String
  isMentorResponse Boolean             @default(false)
  isResolved       Boolean             @default(false)
  likes            Int                 @default(0)
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId          String
  video            VideoDriveLink      @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           MentorshipComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          MentorshipComment[] @relation("CommentReplies")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([videoId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([userId])
}

model UserProgress {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String
  video       VideoDriveLink @relation(fields: [videoId], references: [id], onDelete: Cascade)
  completed   Boolean        @default(true)
  completedAt DateTime       @default(now())

  @@unique([userId, videoId])
}

model VideoNote {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId          String
  video            VideoDriveLink @relation(fields: [videoId], references: [id], onDelete: Cascade)
  timestampSeconds Int            @default(0)
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LandingConfig {
  id                   String   @id @default("singleton")
  heroTitle            String   @default("El Motor de Aprendizaje Abierto con IA Nativa & Mentoría")
  heroSubtitle         String   @default("DocentOS es la alternativa moderna, liviana y modular de código abierto frente a plataformas LMS tradicionales monolíticas como Moodle u Odoo LMS.")
  heroMediaUrl         String   @default("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop")
  heroCtaText          String   @default("Explorar Cursos")
  heroCtaLink          String   @default("#courses")
  heroSecondaryCtaText String   @default("Pase VIP")
  heroSecondaryCtaLink String   @default("#vip")
  featuredCourseIds    String   @default("[]")
  bannerEnabled        Boolean  @default(true)
  bannerText           String   @default("🚀 Motor de IA optimizado, gestión de guías vocales e integración nativa con Google Drive.")
  bannerLinkText       String   @default("Ver Novedades")
  bannerLinkUrl        String   @default("#")
  benefitsJson         String   @default("[]")
  testimonialsJson     String   @default("[]")
  footerText           String   @default("Created and maintained by Giantucchi (Jose Luis Hernandez Hernandez)")
  githubUrl            String   @default("https://github.com/giantucchi/docentos")
  discordUrl           String   @default("")
  twitterUrl           String   @default("")
  linkedinUrl          String   @default("")
  updatedAt            DateTime @updatedAt
}

model TTSGuide {
  id         String   @id @default(uuid())
  courseId   String
  moduleId   String?
  videoId    String?
  title      String
  scriptText String
  voiceId    String
  voiceSpeed Float    @default(1)
  mentorName String
  avatarUrl  String?
  xpReward   Int      @default(50)
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String   @default("")
  createdAt DateTime @default(now())
}
